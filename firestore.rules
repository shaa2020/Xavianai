rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    
    // Core Membership Helper
    function isMember(familyId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             get(/databases/$(database)/documents/families/$(familyId)).data.parents.hasAny([request.auth.uid]);
    }

    // Profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Families
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); // Simplified to ensure joining always works
    }

    // Care Logs
    match /families/{familyId}/logs/{logId} {
      allow list, get: if isMember(familyId);
      allow create: if isMember(familyId);
      allow delete: if isMember(familyId);
      allow update: if false; 
    }
  }
}
