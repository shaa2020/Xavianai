{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data including family connection",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "familyId": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "familyId"]
    },
    "CareLog": {
      "title": "Care Log",
      "description": "A log entry for baby care activity",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["feeding", "sleep", "diaper", "health", "behavior", "medication"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" },
        "note": { "type": "string" },
        "parentId": { "type": "string" },
        "familyId": { "type": "string" },
        "rawInput": { "type": "string" }
      },
      "required": ["type", "timestamp", "familyId", "parentId"]
    },
    "Family": {
      "title": "Family",
      "description": "Family unit containing baby info and linked parents",
      "type": "object",
      "properties": {
        "babyName": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "string" },
        "height": { "type": "string" },
        "dailyChecklist": {
          "type": "object",
          "properties": {
            "vitamins": { "type": "boolean" },
            "tummyTime": { "type": "boolean" },
            "bath": { "type": "boolean" },
            "date": { "type": "string" }
          }
        },
        "lastAction": { "type": "object" }
      },
      "required": ["babyName", "parents"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profiles"
    },
    "/families/{familyId}": {
      "schema": "Family",
      "description": "Family settings and baby profile"
    },
    "/families/{familyId}/logs/{logId}": {
      "schema": "CareLog",
      "description": "The historical care logs for a specific family"
    }
  }
}
